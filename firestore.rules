rules_version = '2';

// Regras de segurança do Firestore para o DSS Hub Dashboard.
// Só os e-mails autorizados da equipe podem ler/escrever qualquer dado.
service cloud.firestore {
  match /databases/{database}/documents {

    // E-mails autorizados — as 3 sócias da DSS Hub.
    function emailAutorizado() {
      return request.auth != null &&
        request.auth.token.email in [
          'danyy.jonathan@gmail.com',
          'simonedasilvasantos173@gmail.com',
          'suellengarcia.silva@gmail.com'
        ];
    }

    match /{document=**} {
      allow read, write: if emailAutorizado();
    }
  }
}
