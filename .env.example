# ============================================================
# Configuração do Firebase (modo nuvem real)
# ------------------------------------------------------------
# Enquanto estas variáveis NÃO estiverem preenchidas, o app roda
# em MODO DEMO (dados no navegador, login fake). Isso serve só
# para testar o visual. Para ligar a nuvem real:
#
# 1. Crie um projeto em https://console.firebase.google.com
# 2. Adicione um app Web e copie os valores abaixo
# 3. Ative Authentication > Sign-in method > Google
# 4. Crie um banco Firestore (modo produção)
# 5. Copie este arquivo para ".env" e preencha os valores
# ============================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# E-mails autorizados a entrar (separados por vírgula).
# Só estes conseguem logar com o Google.
VITE_ALLOWED_EMAILS=danyy.jonathan@gmail.com
