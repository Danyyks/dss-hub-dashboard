# ============================================================
# Configuração do Firebase (opcional)
# ------------------------------------------------------------
# O app já vem com a config pública da DSS Hub embutida como
# reserva, então NÃO é obrigatório preencher isto para rodar.
# Preencha só se quiser apontar para OUTRO projeto Firebase —
# estas variáveis têm prioridade sobre a config embutida.
#
# Para testar a interface sem login Google, use o modo demo:
#   VITE_DEMO=1 npm run dev
# ============================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# E-mails autorizados a entrar (separados por vírgula).
# Só estes conseguem logar com o Google.
VITE_ALLOWED_EMAILS=danyy.jonathan@gmail.com
